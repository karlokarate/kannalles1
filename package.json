{
  "name": "kh-checker-v2",
  "private": true,
  "version": "2.2.4",
  "description": "Installierbare PWA mit deterministischer Kohlenhydratberechnung und versioniertem Daten-Gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlokarate/kannalles1.git"
  },
  "bugs": {
    "url": "https://github.com/karlokarate/kannalles1/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "api:emit": "node scripts/emit-openapi.mjs",
    "api:emit:check": "node scripts/emit-openapi.mjs --check",
    "api:lint": "redocly lint contracts/generated/search-api.openapi.yaml",
    "api:orval": "orval --config orval.config.ts",
    "api:docs": "node scripts/build-api-docs.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:verify": "npm run api:emit:check && npm run api:lint && node scripts/verify-generated-artifacts.mjs",
    "api:check": "node scripts/check-generated-drift.mjs",
    "contract:validate": "npm run api:verify",
    "test": "vitest run src contracts server api/_lib scripts",
    "test:contracts": "vitest run contracts",
    "test:watch": "vitest src contracts",
    "typecheck": "tsc -b",
    "typecheck:generated": "tsc -p tsconfig.generated.json",
    "check:server": "node --check server/index.mjs && node --check server/generated/search-api.schemas.mjs",
    "check": "npm run check:version && npm run api:check && npm run check:workflow && npm run check:containers:static && npm run check:search-index:static && npm run check:secrets && npm run typecheck && npm run typecheck:generated && npm run lint && npm test && npm run check:server && npm run check:scripts && npm run build && npm run check:bundle && npm run check:pages",
    "lint": "biome lint src/App.tsx src/main.tsx src/styles.css src/lib server e2e contracts/source scripts public-template/api-diagnose.js vite.config.ts playwright.config.ts orval.config.ts",
    "check:pages": "node scripts/verify-pages-build.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "release": "node scripts/build-release.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:gateway": "node scripts/verify-gateway-contract.mjs",
    "check:containers:static": "node scripts/check-container-pins.mjs",
    "check:search-index": "node deploy/search-index/preflight.mjs",
    "check:search-index:static": "node deploy/search-index/preflight.mjs --static",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:history": "node scripts/check-secrets.mjs --history",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "monitor:gateway": "node scripts/monitor-gateway.mjs",
    "check:workflow": "node scripts/validate-workflow.mjs",
    "predev": "npm run prepare:public",
    "prebuild": "npm run prepare:public",
    "prepare:public": "node scripts/prepare-public.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "audit": "node scripts/run-npm-audit.mjs",
    "check:version": "node scripts/verify-version.mjs",
    "check:all": "npm run check && npm run test:e2e && npm run audit"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "hono": "4.12.29",
    "lucide-react": "1.24.0",
    "openai": "6.46.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "6.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.3",
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "2.38.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-legacy": "8.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "abortcontroller-polyfill": "1.7.8",
    "autoprefixer": "10.5.2",
    "msw": "2.15.0",
    "orval": "8.21.0",
    "postcss": "8.5.17",
    "terser": "5.49.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "yaml": "^2.9.0"
  }
}
