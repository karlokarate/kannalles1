{
  "name": "kh-checker-v2",
  "private": true,
  "version": "2.2.4",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "api:emit": "node scripts/emit-openapi.mjs",
    "api:emit:check": "node scripts/emit-openapi.mjs --check",
    "api:lint": "redocly lint contracts/generated/search-api.openapi.yaml",
    "api:orval": "orval --config orval.config.ts",
    "api:docs": "node scripts/build-api-docs.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:verify": "npm run api:emit:check && npm run api:lint && node scripts/verify-generated-artifacts.mjs",
    "api:check": "node scripts/check-generated-drift.mjs",
    "contract:validate": "npm run api:verify",
    "test": "vitest run src contracts",
    "test:contracts": "vitest run contracts",
    "test:watch": "vitest src contracts",
    "typecheck": "tsc -b",
    "typecheck:generated": "tsc -p tsconfig.generated.json",
    "check:server": "node --check server/index.mjs && node --check server/generated/search-api.schemas.mjs",
    "check": "npm run check:version && npm run api:check && npm run check:workflow && npm run typecheck && npm run typecheck:generated && npm run lint && npm test && npm run check:server && npm run check:scripts && npm run build && npm run check:pages",
    "lint": "biome lint src/App.tsx src/main.tsx src/styles.css src/lib server e2e contracts/source scripts vite.config.ts playwright.config.ts orval.config.ts",
    "check:pages": "node scripts/verify-pages-build.mjs",
    "check:release": "bash scripts/check-release.sh",
    "release": "bash scripts/build-release.sh",
    "check:scripts": "bash -n START-ANDROID-TERMUX.sh scripts/*.sh && for file in scripts/*.mjs; do node --check \"$file\"; done && node --check contracts/source/search-api.contract.mjs && python3 -m py_compile .github/scripts/validate_release_bundle.py",
    "check:workflow": "node scripts/validate-workflow.mjs",
    "predev": "npm run prepare:public",
    "prebuild": "npm run prepare:public",
    "prepare:public": "node scripts/prepare-public.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit": "node scripts/run-npm-audit.mjs",
    "check:version": "node scripts/verify-version.mjs",
    "check:all": "npm run check && npm run test:e2e && npm run audit"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.4.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "hono": "4.12.29",
    "lucide-react": "1.24.0",
    "openai": "6.46.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.3",
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "2.38.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "msw": "2.15.0",
    "orval": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "yaml": "^2.9.0"
  }
}
