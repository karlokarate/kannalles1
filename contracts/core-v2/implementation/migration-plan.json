{
  "plan": "kh-checker-offline-hard-cutover",
  "version": "1.0.0",
  "authority": "docs/offline-cutover/implementation-plan.json",
  "compatibilityPolicy": {
    "backwardCompatibilityLayer": false,
    "dualProductAuthority": false,
