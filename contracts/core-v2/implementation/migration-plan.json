  "orderedSteps": [
    {"order": 1, "owner": "atlas", "action": "freeze_catalog_native_domain_and_override_contradictory_contracts"},
    {"order": 2, "owner": "forge", "action": "replace_catalog_runtime_with_manifest_driven_atomic_a_b_opfs_lifecycle"},
    {"order": 3, "owner": "helix", "action": "replace_legacy_resolver_architecture_with_pure_catalog_evidence_resolution"},
    {"order": 4, "owner": "lumen", "action": "replace_app_settings_and_user_data_boundaries_without_online_product_fields"},
    {"order": 5, "owner": "sentinel", "action": "prove_real_browser_runtime_and_remove_obsolete_dependencies"},
    {"order": 6, "owner": "owner", "action": "delete_superseded_legacy_tree_after_import_scan_and_integrated_replacement"}
  ],
  "catalogRollback": "rollback is limited to the previously verified inactive/active catalog slot; no legacy product runtime may be reactivated"
}
