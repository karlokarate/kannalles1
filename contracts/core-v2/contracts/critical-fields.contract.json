{
  "contract": "kh-checker-critical-fields",
  "version": "3.0.0",
  "normativeKeywords": ["MUST", "MUST_NOT", "SHOULD", "MAY"],
  "authority": {
    "productData": "verified_production_v1_sqlite_catalog",
    "search": "one_active_catalog_slot",
    "networkProductFallback": false,
    "dualAuthority": false
  },
  "fields": {
    "search": {
      "requiredOutcomeStates": [
        "resolved",
        "needs_product_choice",
        "needs_unit_calibration",
        "not_found",
        "temporarily_unavailable"
      ],
      "MUST": [
        "canonicalize_query_before_local_catalog_search",
        "initialize_or_reuse_verified_catalog_before_query",
        "query_exactly_one_active_catalog_slot",
        "preserve_sqlite_result_order_without_application_reranking",
        "deduplicate_identical_in_flight_catalog_requests",
        "return_typed_outcome_instead_of_throwing_to_ui",
        "allow_immediate_manual_retry",
        "show_original_redacted_catalog_diagnostics_in_technical_details",
        "issue_zero_product_search_or_product_detail_network_requests"
      ],
      "MUST_NOT": [
        "install_local_cooldown",
        "disable_retry_due_to_local_request_counter",
        "issue_search_requests_while_user_is_typing",
        "call_remote_ai_for_parsing_or_product_resolution",
        "fallback_to_search_a_licious_off_legacy_off_v2_or_off_v3",
        "read_from_two_catalog_authorities_for_one_user_action",
        "activate_partial_unverified_or_corrupt_catalog",
        "replace_no_result_with_unrelated_product"
      ]
    },
    "unitResolution": {
      "defaultGoal": "smallest_reliably_proven_edible_unit",
      "MUST": [
        "preserve_explicit_user_unit",
        "prefer_user_calibration_for_matching_scope_and_unit",
        "prefer_explicit_single_unit_over_serving_and_package",
        "prefer_derived_unit_from_explicit_count_and_net_weight",
        "place_selected_smallest_unit_first_in_selector",
        "keep_package_and_mass_options_available_after_smallest_unit",
        "return_needs_unit_calibration_when_countable_unit_weight_is_unknown"
      ],
      "MUST_NOT": [
        "convert_piece_to_portion_without_user_confirmation",
        "interpret_bare_serving_quantity_as_piece_weight",
        "interpret_packaging_unit_count_as_edible_piece_count",
        "guess_typical_piece_weight",
        "select_package_when_smaller_proven_unit_exists",
        "tunnel_legacy_off_fields_around_catalog_unit_evidence"
      ]
    },
    "calibration": {
      "measurementModes": ["single_unit", "group_weighing"],
      "groupWeighing": {
        "measuredCount": {"type": "integer", "minimum": 2, "userEditable": true},
        "measuredTotalWeightG": {"type": "number", "exclusiveMinimum": 0},
        "derivedUnitWeightG": "measuredTotalWeightG / measuredCount",
        "derivedCarbsPerUnitG": "derivedUnitWeightG * currentCarbsPer100g / 100"
      },
      "MUST": [
        "show_live_derived_unit_weight",
        "show_live_derived_carbs_per_unit",
        "recalculate_requested_total_after_confirmation",
        "persist_calibration_after_confirmation",
        "insert_saved_calibration_as_recommended_first_option",
        "reuse_saved_weight_on_future_matching_searches",
        "recompute_carbs_from_current_carbs_per_100g"
      ],
      "MUST_NOT": [
        "treat_saved_carbs_per_unit_as_authoritative",
        "reuse_piece_calibration_for_package",
        "cross_product_scope_without_explicit_generic_scope"
      ]
    },
    "calculation": {
      "formula": "amount * unitWeightG * carbohydratesPer100g / 100",
      "rounding": {
        "internal": "no_rounding_before_final_result",
        "display": "user_setting_0_1_or_2_decimals"
      },
      "MUST": [
        "retain_full_precision_in_storage",
        "store_measurement_provenance",
        "return_null_total_when_required_unit_weight_is_missing"
      ]
    }
  }
}
