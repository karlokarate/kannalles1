{
  "contract": "kh-checker-search-execution",
  "version": "3.0.0",
  "input": {
    "rawInput": "string",
    "canonicalQuery": "string",
    "sourceMode": [
      "api",
      "clinic"
    ],
    "sourceModeCompatibility": {
      "api": "deprecated_internal_name_for_offline_catalog_until_next_domain_schema_major",
      "networkProductAccess": false
    },
    "requestedPageSize": [
      10,
      15,
      20
    ]
  },
  "pipeline": [
    {
      "order": 1,
      "step": "parse",
      "rules": [
        "extract_amount_and_unit_before_product_search",
        "remove_amount_and_unit_tokens_from_product_query",
        "apply_controlled_typo_corrections",
        "never_call_remote_ai_parser"
      ]
    },
    {
      "order": 2,
      "step": "catalog_readiness",
      "rules": [
        "load_versioned_manifest_from_same_origin",
        "reuse_verified_opfs_catalog_before_download",
        "deduplicate_catalog_initialization",
        "verify_size_sha256_application_id_user_version_schema_and_product_count_before_activation",
        "never_activate_partial_or_unverified_catalog"
      ]
    },
    {
      "order": 3,
      "step": "offline_search",
      "rules": [
        "execute_contentless_fts5_query_inside_dedicated_worker",
        "use_generated_runtime_ssot_for_fts_escaping_and_sql",
        "sort_exact_name_then_prefix_then_contains_then_popularity_then_name_then_product_id",
        "issue_zero_product_network_requests",
        "return_empty_only_after_reachable_catalog_query"
      ]
    },
    {
      "order": 4,
      "step": "offline_product_resolution",
      "rules": [
        "read_selected_product_from_same_sqlite_catalog",
        "use_generated_gtin_and_rescue_codecs",
        "decode_nutrition_basis_unit_evidence_and_image_key_from_generated_ssot",
        "never_fan_out_product_detail_requests",
        "never_replace_missing_barcode_with_unrelated_product"
      ]
    },
    {
      "order": 5,
      "step": "unit_resolution",
      "rules": [
        "preserve_explicit_user_unit",
        "prefer_user_calibration_for_matching_scope_and_unit",
        "prefer_proven_catalog_unit_over_serving_and_package",
        "keep_package_and_mass_options_available",
        "return_needs_unit_calibration_for_countable_unit_without_proven_weight",
        "never_guess_piece_weight"
      ]
    },
    {
      "order": 6,
      "step": "typed_outcome",
      "rules": [
        "never_propagate_raw_worker_or_sqlite_exception_to_render_tree",
        "retry_button_remains_enabled",
        "no_local_cooldown",
        "catalog_integrity_or_runtime_failure_maps_to_temporarily_unavailable"
      ]
    }
  ],
  "outcomeMapping": {
    "hits_and_auto_resolvable": "resolved",
    "hits_but_ambiguous": "needs_product_choice",
    "product_and_nutrition_but_no_requested_unit_weight": "needs_unit_calibration",
    "reachable_catalog_with_no_hits": "not_found",
    "catalog_missing_invalid_locked_or_unsupported": "temporarily_unavailable"
  },
  "networkBudgets": {
    "catalogManifestRequestsPerInitialization": {
      "maximum": 1,
      "scope": "same_origin_catalog_update_check",
      "hardLocalLock": false
    },
    "catalogArtifactRequestsPerVersion": {
      "maximum": 1,
      "scope": "same_origin_download_only_when_version_or_hash_changed",
      "hardLocalLock": false
    },
    "searchRequestsPerAction": {
      "maximum": 0,
      "scope": "product_network",
      "hardLocalLock": false
    },
    "selectedProductDetailRequests": {
      "maximum": 0,
      "scope": "product_network"
    },
    "remoteAiRequestsPerAction": {
      "maximum": 0
    }
  }
}
