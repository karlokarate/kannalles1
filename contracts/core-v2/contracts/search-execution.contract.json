{
  "contract": "kh-checker-search-execution",
  "version": "2.2.0",
  "input": {
    "rawInput": "string",
    "canonicalQuery": "string",
    "sourceMode": [
      "api",
      "clinic"
    ],
    "requestedPageSize": [
      10,
      15,
      20
    ]
  },
  "pipeline": [
    {
      "order": 1,
      "step": "parse",
      "rules": [
        "extract_amount_and_unit_before_product_search",
        "remove_amount_and_unit_tokens_from_product_query",
        "apply_controlled_typo_corrections"
      ]
    },
    {
      "order": 2,
      "step": "query_cache",
      "rules": [
        "browser_cache_key_includes_runtime_lane_identity",
        "gateway_cache_key_includes_effective_upstream_backend_identity",
        "normalize_and_validate_direct_or_gateway_responses",
        "return_fresh_hit_without_network"
      ]
    },
    {
      "order": 3,
      "step": "primary_search",
      "rules": [
        "empty_gateway_selects_direct_search_a_licious",
        "optional_personal_off_credentials_are_used_only_for_world_openfoodfacts_requests",
        "configured_gateway_is_authoritative_for_the_whole_action",
        "gateway_lane_uses_its_configured_search_backend"
      ]
    },
    {
      "order": 4,
      "step": "single_fallback",
      "rules": [
        "direct_lane_falls_back_once_to_open_food_facts_legacy",
        "gateway_lane_owns_its_internal_fallback",
        "maximum_total_search_requests_per_action_is_two"
      ]
    },
    {
      "order": 5,
      "step": "stale_cache",
      "rules": [
        "use_if_all_network_backends_failed",
        "mark_as_stale_and_show_source_age"
      ]
    },
    {
      "order": 6,
      "step": "typed_failure",
      "rules": [
        "never_propagate_raw_exception_to_render_tree",
        "retry_button_remains_enabled",
        "retry_after_is_advisory_only"
      ]
    }
  ],
  "outcomeMapping": {
    "hits_and_auto_resolvable": "resolved",
    "hits_but_ambiguous": "needs_product_choice",
    "product_and_nutrition_but_no_requested_unit_weight": "needs_unit_calibration",
    "reachable_sources_with_no_hits": "not_found",
    "no_source_and_no_cache": "temporarily_unavailable"
  },
  "networkBudgets": {
    "offAccountVerification": {
      "maximum": 1,
      "scope": "explicit settings action, not a search action"
    },
    "browserGatewayRequestsPerAction": {
      "maximum": 1,
      "hardLocalLock": false
    },
    "browserDirectRequestsPerAction": {
      "maximum": 2,
      "hardLocalLock": false
    },
    "searchRequestsPerAction": {
      "maximum": 2,
      "scope": "selected_runtime_lane",
      "hardLocalLock": false
    },
    "selectedProductDetailRequests": {
      "primaryMaximum": 1,
      "conditionalFallbackMaximum": 1,
      "condition": "selected_product_missing_required_nutrition_or_unit_evidence"
    }
  }
}
