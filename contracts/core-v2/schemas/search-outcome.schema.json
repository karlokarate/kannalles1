{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kh-checker.local/schemas/search-outcome.schema.json",
  "title": "KH Checker Catalog SearchOutcome",
  "type": "object",
  "required": [
    "requestId",
    "status",
    "query",
    "sourceMode",
    "diagnostics"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "resolved",
        "needs_product_choice",
        "needs_unit_calibration",
        "not_found",
        "temporarily_unavailable"
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "raw",
        "canonical",
        "productOnly"
      ],
      "properties": {
        "raw": {
          "type": "string"
        },
        "canonical": {
          "type": "string"
        },
        "productOnly": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sourceMode": {
      "type": "string",
      "enum": [
        "catalog",
        "clinic"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "diagnostics": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "operation",
        "message",
        "technical",
        "occurredAt",
        "retryAllowedImmediately",
        "activeSlot",
        "attemptedSlot",
        "rollbackSlot",
        "catalogVersion",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^CATALOG_[A-Z0-9_]+$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "initialize",
            "manifest",
            "download",
            "validate",
            "install",
            "activate",
            "open",
            "search",
            "product_lookup",
            "rollback"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "technical": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "retryAllowedImmediately": {
          "const": true
        },
        "activeSlot": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "a",
            "b",
            null
          ]
        },
        "attemptedSlot": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "a",
            "b",
            null
          ]
        },
        "catalogVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "rollbackSlot": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "a",
            "b",
            null
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
