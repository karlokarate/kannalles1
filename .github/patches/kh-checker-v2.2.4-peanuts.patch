+describe('generic peanut identity regression', () => {
+  it('keeps Erdnüsse as a generic food instead of forcing an arbitrary exact product', async () => {
+    const { isGenericCategoryQuery, genericIdentityCompatible } = await import('./identity');
+    expect(isGenericCategoryQuery('Erdnüsse')).toBe(true);
+    expect(genericIdentityCompatible('Erdnüsse', {
+      code: 'peanut-plain',
+      product_name_de: 'Erdnüsse geröstet und gesalzen',
+      brands: 'Testmarke',
+      completeness: 0.9,
+      nutriments: { carbohydrates_100g: 12 }
+    })).toBe(true);
+    expect(genericIdentityCompatible('Erdnüsse', {
+      code: 'peanut-butter',
+      product_name_de: 'Erdnussbutter cremig',
+      brands: 'Testmarke',
+      completeness: 0.9,
+      nutriments: { carbohydrates_100g: 14 }
+    })).toBe(false);
+  });
+});
