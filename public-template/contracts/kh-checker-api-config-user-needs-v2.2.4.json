{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 3,
  "application": {
    "name": "KH Checker",
    "version": "__KH_APP_VERSION__",
    "artifact": "static-pwa",
    "manualAndOfflineWithoutGateway": true,
    "gatewayRequiredForGlobalSearch": true
  },
  "architecture": {
    "browserDataAccess": "gateway-only",
    "canonicalApiPrefix": "/api/v1",
    "primarySearch": "self-hosted-search-index",
    "searchFallback": "open-food-facts-legacy",
    "publicSearchALicious": "explicit-diagnostics-only",
    "productPrimary": "open-food-facts-v3.6",
    "productCompatibilityFallback": "open-food-facts-v2",
    "distributedCoordination": "isolated-redis",
    "distributedResponseCache": "separate-redis-fail-soft",
    "portableGatewayRuntime": "node-express-container",
    "optionalAdapters": [],
    "deploymentProfiles": ["manual-only", "full-app"]
  },
  "api": {
    "health": "GET /api/v1/health",
    "search": "GET /api/v1/search",
    "product": "GET /api/v1/product/{code}",
    "aiParse": "POST /api/v1/ai/parse",
    "legacyAliasesDeprecated": true
  },
  "localRepositories": {
    "order": ["memory", "indexeddb", "localstorage-fallback"],
    "versioned": true,
    "runtimeValidated": true,
    "categoriesIndependentlyDeletable": [
      "settings", "session", "history", "favorites", "calibrations", "api-cache"
    ]
  },
  "qualityAndTooling": {
    "generatorPipeline": {
      "authoritativeInput": "contracts/source/search-api.contract.mjs",
      "clientGenerator": "Orval fetch",
      "runtimeValidation": "Zod",
      "openapi": "3.1.0",
      "canonicalEol": "LF",
      "hashEolIndependent": true
    },
    "requiredBrowsers": [
      "chromium-desktop", "chromium-android", "firefox-desktop", "webkit-iphone"
    ],
    "directUpstreamUrlInBrowserBundle": "release-blocker",
    "liveGatewayGate": "https-health-coordination-own-index-search-canary"
  },
  "privacy": {
    "searchTermsAndBarcodesDestination": "configured-data-gateway",
    "productImagesMayLoadDirectlyFrom": "images.openfoodfacts.org",
    "imageCdnReceivesIpAndRequestedUrl": true,
    "frontendSecretsAllowed": false,
    "historyConsentDoesNotImplyCacheConsent": true
  },
  "safety": {
    "labelMustBeChecked": true,
    "notForUnverifiedTherapyOrInsulinDosing": true,
    "sourceAndDataAgeVisible": true
  },
  "licenses": {
    "openFoodFactsData": "ODbL",
    "openFoodFactsImages": "per-image-license",
    "searchALicious": "AGPL-3.0"
  }
}
