{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/lib/catalog/catalog.worker.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "server/index.mjs",
    "api/**/*.mjs",
    "scripts/**/*.mjs",
    "e2e/**/*.spec.ts",
    "e2e/start-real-preview.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "Catalog/**/*.ts",
    "server/**/*.{js,mjs,ts}",
    "api/**/*.{js,mjs,ts}",
    "scripts/**/*.{js,mjs,ts}",
    "e2e/**/*.ts",
    "contracts/**/*.ts",
    "*.config.{js,cjs,mjs,ts}"
  ],
  "ignore": [
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "public/**",
    "public-template/**",
    "Catalog/runtime/**"
  ],
  "ignoreBinaries": [
    "depcruise",
    "knip",
    "python3"
  ]
}
