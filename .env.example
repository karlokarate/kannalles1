# Frontend: erforderlicher Daten-Gateway für den produktiven Pages-Build.
# Keine direkten Browseraufrufe zu OFF-APIs mehr. Beispiel:
# https://kh-gateway.vercel.app
VITE_DATA_GATEWAY_URL=https://kh-gateway.vercel.app

# Legacy-Alias aus v2.1; der neue Name oben hat Vorrang.
VITE_DATA_API_BASE_URL=

# Frontend: optionaler externer HTTPS-Parser-Endpunkt. Leer im statischen Pages-Build.
# Ein relativer /api-Pfad funktioniert nur zusammen mit dem optionalen Node-Server.
VITE_AI_PARSE_URL=

# Backend
HOST=0.0.0.0
PORT=8787
TRUST_PROXY=0

# Kommagetrennte, exakte Browser-Origins oder *.
# Ohne Wert akzeptiert der Server nur Requests ohne Origin sowie Loopback-Origins.
CORS_ORIGINS=http://127.0.0.1:18121,http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Hinweis: OFF_USER_AGENT und OFF_CONTACT_EMAIL sind aktuell im Code hart codiert.
# Diese Variablen werden zurzeit nicht ausgewertet.
OFF_USER_AGENT=KH-Checker/2.2.4 (+https://karlokarate.github.io/kannalles1/; contact: chrisfischtopher@googlemail.com)
OFF_CONTACT_EMAIL=chrisfischtopher@googlemail.com

# Optional: OFF-Account nur serverseitig im Gateway/Node-Server verwenden.
# Der Server meldet sich damit einmal gegen /cgi/login.pl an, cached die
# Session-Cookie im Prozess und verwendet sie fuer Folge-Requests wieder.
# Bei erkennbar abgelaufener Session wird genau ein Re-Login versucht.
# Niemals in VITE_* Variablen oder in die statische Client-App legen.
OFF_USERNAME=
OFF_PASSWORD=
