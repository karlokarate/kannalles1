# Frontend: Daten-Gateway für die globale Produktsuche. Leer lassen ist zulässig:
# Manuelle Berechnung, App-Shell und bereits lokal gespeicherte Daten bleiben nutzbar.
# Keine direkten Browseraufrufe zu OFF-APIs. Beispiel: https://gateway.example.org
VITE_DATA_GATEWAY_URL=

# CI-/Deployment-Gate für denselben Dienst (kein VITE-Präfix erforderlich).
DATA_GATEWAY_URL=

# Release-Artefakte benennen ihren Funktionsumfang explizit. `full-app`
# verlangt dieselbe öffentliche HTTPS-URL in VITE_DATA_GATEWAY_URL;
# `manual-only` verlangt ein leeres Gateway.
RELEASE_DEPLOYMENT_PROFILE=manual-only

# Deprecated Kompatibilitätsalias für bestehende 2.x-Deployments; nicht neu
# verwenden und vor dem nächsten Major-Upgrade auf VITE_DATA_GATEWAY_URL migrieren.
VITE_DATA_API_BASE_URL=

# Backend
HOST=0.0.0.0
PORT=8787
# Nur hinter einem kontrollierten Reverse Proxy auf 1 setzen. Express leitet
# daraus req.ip ab; ungeprüfte X-Forwarded-For-Header werden sonst ignoriert.
TRUST_PROXY=0

# Kommagetrennte, exakte Browser-Origins. `*` gilt nie für den kostenpflichtigen
# AI-Endpunkt, sobald OPENAI_API_KEY gesetzt ist; dort ist eine explizite Origin nötig.
# Ohne Wert akzeptiert der Server nur Requests ohne Origin sowie echte
# Same-Origin-Aufrufe; Cross-Origin-Loopback braucht ebenfalls einen Eintrag.
CORS_ORIGINS=http://127.0.0.1:18121,http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_REASONING_EFFORT=none
# Produktions-Pflicht sobald OPENAI_API_KEY gesetzt ist: zufälliges Secret mit
# mindestens 32 Zeichen, z. B. `openssl rand -base64 32`. Fehlt es oder ist es
# zu kurz, bleibt der Paid-AI-Endpunkt fail-closed; der lokale Parser funktioniert.
# Nie als VITE_* setzen und nie im Browserbundle ausliefern.
AI_SAFETY_SALT=
OPENAI_DEADLINE_MS=12000
# Paid-AI hat kombinierte globale und pseudonyme Nutzerbudgets. Die Tageswerte
# sind rollierende 24-Stunden-Tokenbudgets, keine Kalenderzähler.
AI_PARSE_GLOBAL_RATE_LIMIT_PER_MINUTE=30
AI_PARSE_PER_USER_RATE_LIMIT_PER_MINUTE=6
AI_PARSE_GLOBAL_RATE_LIMIT_PER_DAY=300
AI_PARSE_PER_USER_RATE_LIMIT_PER_DAY=30

OFF_USER_AGENT=KH-Checker/2.2.4 (+https://example.org/kh-checker; contact: ops@example.org)
OFF_CONTACT_EMAIL=ops@example.org

# Produktionspflicht: zufälliges Backend-Secret mit mindestens 32 Zeichen.
# Daraus werden irreversible Budget-IDs für die vom Express-Trust-Proxy-Modell
# bestätigte Client-IP gebildet. Nie als VITE_* setzen.
GATEWAY_CLIENT_SALT=
CLIENT_SEARCH_RATE_LIMIT_PER_MINUTE=6
CLIENT_PRODUCT_RATE_LIMIT_PER_MINUTE=10

# Primärer eigener Search-a-licious-/OFF-Export-Index; Endpunkt endet auf /search.
# Production akzeptiert standardmäßig nur HTTPS. Das Compose-Produktionsoverlay
# setzt die HTTP-Ausnahme ausschließlich für `api` im privaten Container-Netz.
SEARCH_INDEX_URL=https://search-index.example.org/search
SEARCH_INDEX_ALLOW_INSECURE_HTTP=0
SEARCH_INDEX_HEALTH_TIMEOUT_MS=1000
# Öffentlicher Search-a-licious-Endpunkt ausschließlich für explizite Diagnose
# (`search_api=search-a-licious`), niemals als impliziter Auto-Fallback.
SEARCH_A_LICIOUS_URL=

# Produktionsrollen bleiben physisch getrennt: Koordination enthält Limiter,
# Single-Flight und Circuits (fail-closed/noeviction); der Antwortcache darf
# unabhängig ausfallen oder LRU-Keys verwerfen. Dieselbe URL/DB für beide
# Rollen wird in Production abgelehnt. REDIS_URL ist nur ein Legacy-Fallback
# für lokale Einzelinstanzen und soll bei neuen Deployments leer bleiben.
REDIS_COORDINATION_URL=redis://redis-coordination:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_URL=
REDIS_FAILURE_MODE=closed
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_COORDINATION_MAXMEMORY=64mb
REDIS_COORDINATION_CONTAINER_MEMORY_LIMIT=128m
REDIS_CACHE_MAXMEMORY=256mb
REDIS_CACHE_CONTAINER_MEMORY_LIMIT=384m
REQUIRE_DISTRIBUTED_COORDINATION=0
# Nur für einen bewusst genau einmal gestarteten Production-Prozess ohne Redis:
# auf 1 setzen und Betrieb/Skalierung entsprechend absichern. Nie bei mehreren
# Instanzen, Serverless oder Autoscaling verwenden.
ALLOW_SINGLE_INSTANCE_COORDINATION=0

# Das veröffentlichte Search-a-licious-API-Image ist für linux/amd64 per Tag
# und Digest gepinnt. Auf ARM64 ein Image aus exakt dem dokumentierten Commit
# bauen, in eine kontrollierte Registry pushen und hier als name@sha256:… setzen.
SEARCH_A_LICIOUS_API_IMAGE=
# Multi-Arch-Index-Digests der im Produktions-Overlay benötigten Suchkomponenten.
SEARCH_ELASTIC_IMAGE=
# Nur für das optionale `search-ui`-Profil; das veröffentlichte Image ist amd64.
SEARCH_A_LICIOUS_FRONT_IMAGE=

# Separater, persistenter Product-Opener-Eventstream. Der optionale
# Search-a-licious-Updater läuft erst mit `--profile search-updates`; niemals
# einen der beiden Gateway-Redis-Dienste als REDIS_HOST verwenden.
SEARCH_UPDATES_REDIS_MAXMEMORY=128mb
SEARCH_UPDATES_REDIS_CONTAINER_MEMORY_LIMIT=192m

# Ein Fallback startet nur, wenn dieses Restbudget noch verfügbar ist.
MIN_FALLBACK_BUDGET_MS=750

# Optionaler AI-Parser; ohne Key bleibt der lokale Parser Standard.
BUILD_COMMIT=
BUILD_TIMESTAMP=
